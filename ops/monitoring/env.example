# מעתיקים ל-.env וממלאים. את .env לא מעלים ל-GitHub (הוא ב-.gitignore).
PROXY_URL=https://ivm4jwhxpy5vr5hw6lrdy7uyl40zcvnq.lambda-url.us-east-1.on.aws
SITE_URL=https://ackerme.github.io/natbag-monitor/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROM_RETENTION=30d
# אם הפורטים כבר תפוסים במחשב (למשל Grafana אחרת על 3000)
GRAFANA_PORT=3000
PROM_PORT=9090
# לא חובה – רק אם רוצים גרפים מ-CloudWatch בתוך Grafana (ראו ops/terraform)
GRAFANA_AWS_ACCESS_KEY_ID=
GRAFANA_AWS_SECRET_ACCESS_KEY=
